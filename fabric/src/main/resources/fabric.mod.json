{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "assets/doorways/icon.png",
  "environment": "*",
  "contact": {
    "homepage": "https://github.com/itsandrefreitas/doorways",
    "sources": "https://github.com/itsandrefreitas/doorways",
    "issues": "https://github.com/itsandrefreitas/doorways/issues"
  },
  "entrypoints": {
    "main": [
      "com.doorways.fabric.DoorwaysFabric"
    ],
    "fabric-gametest": [
      "com.doorways.fabric.DoorwaysGameTests"
    ],
    "fabric-datagen": [
      "com.doorways.fabric.datagen.DoorwaysDataGen"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
