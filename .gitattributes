# Text files are stored with LF in the repository, whatever the checkout platform does.
* text=auto eol=lf

# Windows scripts must keep CRLF or cmd.exe mishandles them.
*.bat text eol=crlf
*.cmd text eol=crlf

# The Gradle wrapper is a POSIX shell script: CRLF makes it unrunnable on Linux and macOS.
gradlew text eol=lf

# Binaries git must not touch.
*.png binary
*.jar binary
*.docx binary
*.nbt binary
